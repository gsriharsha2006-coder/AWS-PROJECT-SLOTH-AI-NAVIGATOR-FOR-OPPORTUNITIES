# Copy to .env and fill in values. Never commit real secrets.

# Lovable Cloud / database (publishable values only)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only database key (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (test mode) — server-only, never exposed to the browser
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AWS (optional, server-only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
